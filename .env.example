# ==============================================================================
# Masbate Provincial PESO Database - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit or expose the real .env file.
# ==============================================================================

# Supabase Session Pooler Connection String (IPv4 compatible, Port 5432)
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Django Security Key (Use a strong unique random key in production!)
SECRET_KEY=django-insecure-your-secret-key-goes-here-replace-in-production

# Debug Mode — set to False in production / Vercel!
DEBUG=False

# Allowed Hosts — comma-separated
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Your Vercel project URL (e.g. https://masbate-peso.vercel.app)
VERCEL_URL=https://your-project.vercel.app

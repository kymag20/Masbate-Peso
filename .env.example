# ==============================================================================
# Masbate Provincial PESO Database - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit or expose the real .env file.
# ==============================================================================

# Supabase Session Pooler Connection String (IPv4 compatible, Port 5432)
# Format: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Django Security Key (Use a strong unique random key)
SECRET_KEY=django-insecure-your-secret-key-goes-here-replace-in-production

# Debug Mode (True for local development, False for production)
DEBUG=True

# Allowed Hosts (comma-separated list of hostnames or IP addresses)
ALLOWED_HOSTS=localhost,127.0.0.1
